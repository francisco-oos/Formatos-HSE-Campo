# Copia como hse-secrets.properties en la raíz del proyecto.
# El archivo real está ignorado por Git y NO debe versionarse.
#
# HSE_DATA_KEY debe coincidir con el lector que descifra los reportes HSE.
# HERMES_BRIDGE_KEY debe coincidir con OperacionCampo/Hermes y tener
# 16, 24 o 32 bytes UTF-8 para AES.

HSE_DATA_KEY=CHANGE_ME_HSE_DATA_KEY
HERMES_BRIDGE_KEY=CHANGE_ME_16BYTE
